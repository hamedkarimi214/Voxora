<Window x:Class="Voxora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voxora - Voice Recorder"
        Width="{Binding WindowSize.WindowWidth}" Height="{Binding WindowSize.WindowHeight}"
        MinWidth="520" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="White"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <!-- گرادینت‌ها و رنگ‌های اصلی -->
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F6EF7" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WaveFillGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A2C5B" Offset="0"/>
            <GradientStop Color="#000B1120" Offset="1"/>
        </LinearGradientBrush>

        <!-- حذف ظاهر پیش‌فرض اسکرول‌بار ویندوز و سفارشی‌سازی آن -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1E2942" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه‌های منوی سایدبار (با استفاده از Tag برای آیکون) -->
        <Style x:Key="SidebarMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#8A99B5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="icon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13.5" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#151E36"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه فعال سایدبار (Home) -->
        <Style x:Key="SidebarMenuButtonActive" TargetType="Button" BasedOn="{StaticResource SidebarMenuButton}">
            <Setter Property="Background" Value="#1B2848"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
        </Style>

        <!-- استایل دکمه‌های کوچک بالای پنجره -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A233A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه دایره‌ای پخش عادی در لیست -->
        <Style x:Key="CirclePlayButton" TargetType="Button">
            <Setter Property="Background" Value="#1C2438"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="19" Background="{TemplateBinding Background}">
                            <Path Data="M10,8 L19,14 L10,20 Z" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="11" Stretch="Fill" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#283552"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه دایره‌ای در حال پخش (Pause آبی) -->
        <Style x:Key="CircleActiveButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="19" Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="2.5" Height="11" RadiusX="1" RadiusY="1" Fill="White" Margin="1.5,0"/>
                                <Rectangle Width="2.5" Height="11" RadiusX="1" RadiusY="1" Fill="White" Margin="1.5,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه ضبط بزرگ مرکزی -->
        <!-- استایل پیشرفته دکمه ضبط با قابلیت تغییر ظاهر -->
        <Style x:Key="RecordButtonLarge" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="150" Height="150">


                            <!-- حلقه بیرونی قرمز -->
                            <Ellipse x:Name="PulseRing1"
                                 Width="135" Height="135"
                                 Stroke="#EF4444" StrokeThickness="1.5"
                                 Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- حلقه میانی -->
                            <Ellipse x:Name="PulseRing2"
                                 Width="120" Height="120"
                                 Stroke="#192544" StrokeThickness="1.5"
                                 Fill="#0D1426" Opacity="0.7"
                                 RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- حلقه داخلی -->
                            <Ellipse x:Name="PulseRing3"
                                 Width="105" Height="105"
                                 Stroke="#233460" StrokeThickness="1.5"
                                 Fill="#111A30" Opacity="0.9"/>

                            <!-- بدنه اصلی دکمه -->
                            <Border x:Name="ButtonBack"
                                Width="88" Height="88" CornerRadius="44"
                                Background="{StaticResource BrandGradient}"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="#6366F1" BlurRadius="30"
                                                  ShadowDepth="0" Opacity="0.45"/>
                                </Border.Effect>
                                <!-- آیکون میکروفون -->
                                <Path x:Name="ButtonIcon"
                                  Data="M12,2 C9.79,2 8,3.79 8,6 L8,13 C8,15.21 9.79,17 12,17 C14.21,17 16,15.21 16,13 L16,6 C16,3.79 14.21,2 12,2 Z M19,11 C19,14.53 16.39,17.44 13,17.93 L13,21 L11,21 L11,17.93 C7.61,17.44 5,14.53 5,11 L7,11 C7,13.76 9.24,16 12,16 C14.76,16 17,13.76 17,11 L19,11 Z"
                                  Fill="White" Stretch="Uniform" Width="26" Height="32"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="BeginRecordingPulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.75" To="0"
                                                 Duration="0:0:1.1"
                                                 RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.72" To="1.12"
                                                 Duration="0:0:1.1"
                                                 RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.72" To="1.12"
                                                 Duration="0:0:1.1"
                                                 RepeatBehavior="Forever"/>

                                            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.65" To="0.15"
                                                 Duration="0:0:1.1"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.92" To="1.06"
                                                 Duration="0:0:1.1"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.92" To="1.06"
                                                 Duration="0:0:1.1"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever"/>

                                            <DoubleAnimation Storyboard.TargetName="ButtonBack"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1" To="1.07"
                                                 Duration="0:0:0.65"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBack"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1" To="1.07"
                                                 Duration="0:0:0.65"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonIcon"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.72"
                                                 Duration="0:0:0.65"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BeginRecordingPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBack" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- متن دکمه ضبط به وضعیت IsRecording متصل است -->
        <Style x:Key="RecordTitleText" TargetType="TextBlock">
            <Setter Property="Text" Value="Start Recording"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Text" Value="Recording..."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecordSubtitleText" TargetType="TextBlock">
            <Setter Property="Text" Value="Press the button to start recording your voice"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Text" Value="Your voice is being recorded"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- استایل دکمه‌های آیکونی کوچک در کارت‌ها -->
        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2942"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="#0A0E17" BorderBrush="#0A0E17" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0B0F1A" CornerRadius="14,14,0,0" BorderBrush="#151D2E" BorderThickness="0,0,0,1" MouseLeftButtonDown="HeaderGrid_MouseDown">
                <Grid Margin="20,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- لوگو و عنوان Voxora -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Canvas Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Rectangle Width="3.5" Height="10" RadiusX="1.7" RadiusY="1.7" Fill="#3B82F6" Canvas.Left="2" Canvas.Top="9"/>
                            <Rectangle Width="3.5" Height="20" RadiusX="1.7" RadiusY="1.7" Fill="#4F86F7" Canvas.Left="8" Canvas.Top="4"/>
                            <Rectangle Width="3.5" Height="26" RadiusX="1.7" RadiusY="1.7" Fill="#60A5FA" Canvas.Left="14" Canvas.Top="1"/>
                            <Rectangle Width="3.5" Height="16" RadiusX="1.7" RadiusY="1.7" Fill="#4F86F7" Canvas.Left="20" Canvas.Top="6"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="#3B82F6" Canvas.Left="26" Canvas.Top="12.5"/>
                        </Canvas>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Voxora" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Your Voice, Your Words" FontSize="11" Foreground="#4B7BF5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- دکمه‌های کنترل پنجره و آیکون تنظیمات بالا سمت راست -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,4">
                            <Button Style="{StaticResource WindowControlButton}" Command="{Binding WindowMinimizeCommand}">
                                <Rectangle Width="10" Height="1.5" Fill="#7E8BA3"/>
                            </Button>
                            <Button Style="{StaticResource WindowControlButton}" Margin="4,0" Command="{Binding WindowStateCommand}">
                                <Rectangle Width="9" Height="9" Stroke="#7E8BA3" StrokeThickness="1.3" RadiusX="1" RadiusY="1"/>
                            </Button>
                            <Button Style="{StaticResource WindowControlButton}" Command="{Binding WindowCloseCommand}">
                                <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#7E8BA3" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recording-only interface -->
            <Border x:Name="RecordCardBorder"
                Grid.Row="1"
                Margin="24,22,24,18"
                CornerRadius="16"
                ClipToBounds="True"
                BorderBrush="#192544"
                BorderThickness="1">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.38"
                                     GradientOrigin="0.5,0.38"
                                     RadiusX="0.75" RadiusY="0.8">
                        <GradientStop Color="#131E3A" Offset="0"/>
                        <GradientStop Color="#0A0E17" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Grid>
                    <Path Data="M0,130 C110,60 200,170 310,110 C420,50 510,150 640,95 L640,300 L0,300 Z"
                      Fill="#101C36"
                      Stroke="#1E3264"
                      StrokeThickness="1.2"
                      Stretch="Fill"
                      Opacity="0.55"
                      VerticalAlignment="Bottom"
                      Height="150"/>

                    <Border Background="#30EF4444"
                        IsHitTestVisible="False" CornerRadius="14" Margin="0,0,10,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Opacity" Value="0.22"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="12">
                        <Button x:Name="BtnRecordAction"
                            Style="{StaticResource RecordButtonLarge}"
                            HorizontalAlignment="Center"
                            Command="{Binding RecordCommand}"/>

                        <TextBlock 
                               FontWeight="SemiBold"
                               FontSize="18"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,7"/>

                        <TextBlock 
                               FontSize="12.5"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                        <TextBlock Text="Click the microphone to start or stop"
                               FontSize="11"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>
                    </StackPanel>


                    <!-- VOXORA: Live Transcription Indicator -->
                    <Border x:Name="TranscribePanel"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Center"
        Margin="12,0,12,12"
        Padding="14,10"
        CornerRadius="12"
        Background="#E6101B32"
        BorderBrush="#354F86F7"
        BorderThickness="1"
        IsHitTestVisible="False">

                        <Border.RenderTransform>
                            <TranslateTransform Y="8"/>
                        </Border.RenderTransform>

                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Opacity" Value="0"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTranscribing}"
                         Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Width="260">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Animated status indicator -->
                                <Grid Width="34" Height="30"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0">

                                    <Ellipse Width="30" Height="30"
                         Fill="#183B82F6"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>

                                    <Ellipse Width="7" Height="7"
                         Fill="#60A5FA"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTranscribing}"
                                             Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="1" To="0.25"
                                                    Duration="0:0:0.7"
                                                    AutoReverse="True"
                                                    RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>

                                <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                                    <TextBlock Text="TRANSCRIBING AUDIO"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#93C5FD"/>

                                    <TextBlock Text="Converting speech to text..."
                           FontSize="10"
                           Foreground="#94A3B8"
                           Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                       Text="LIVE"
                       FontSize="9"
                       FontWeight="Bold"
                       Foreground="#34D399"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Animated neon progress line -->
                            <Grid Grid.Row="1"
                                  Height="3"
                                  Margin="0,10,0,0"
                                  ClipToBounds="True">

                                <Border Background="#202E4A"
                                        CornerRadius="2"/>

                                <Border Width="75"
                                        HorizontalAlignment="Left"
                                        CornerRadius="2"
                                        Background="#60A5FA"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ScanTransform"
                                        X="-75"/>
                                    </Border.RenderTransform>

                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                    Storyboard.TargetName="ScanTransform"
                                    Storyboard.TargetProperty="X"
                                    From="-75" To="260"
                                    Duration="0:0:1.3"
                                    RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- Status -->
            <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#64748B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Fill" Value="#EF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="Ready to record"
                       FontSize="11"
                       Foreground="#94A3B8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Ready to record"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Text" Value="Recording in progress"/>
                                    <Setter Property="Foreground" Value="#F87171"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
