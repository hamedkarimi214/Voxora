<Window x:Class="Voxora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voxora" 
        Width="{Binding WindowSize.WindowWidth}" Height="{Binding WindowSize.WindowHeight}" 
        MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        BorderThickness="0"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <!-- گرادینت‌ها و رنگ‌های اصلی -->
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F6EF7" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WaveFillGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A2C5B" Offset="0"/>
            <GradientStop Color="#000B1120" Offset="1"/>
        </LinearGradientBrush>

        <!-- حذف ظاهر پیش‌فرض اسکرول‌بار ویندوز و سفارشی‌سازی آن -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#1E2942" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه‌های منوی سایدبار (با استفاده از Tag برای آیکون) -->
        <Style x:Key="SidebarMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#8A99B5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="icon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13.5" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#151E36"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه فعال سایدبار (Home) -->
        <Style x:Key="SidebarMenuButtonActive" TargetType="Button" BasedOn="{StaticResource SidebarMenuButton}">
            <Setter Property="Background" Value="#1B2848"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
        </Style>

        <!-- استایل دکمه‌های کوچک بالای پنجره -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A233A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه دایره‌ای پخش عادی در لیست -->
        <Style x:Key="CirclePlayButton" TargetType="Button">
            <Setter Property="Background" Value="#1C2438"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="19" Background="{TemplateBinding Background}">
                            <Path Data="M10,8 L19,14 L10,20 Z" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="11" Stretch="Fill" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#283552"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه دایره‌ای در حال پخش (Pause آبی) -->
        <Style x:Key="CircleActiveButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="19" Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="2.5" Height="11" RadiusX="1" RadiusY="1" Fill="White" Margin="1.5,0"/>
                                <Rectangle Width="2.5" Height="11" RadiusX="1" RadiusY="1" Fill="White" Margin="1.5,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه ضبط بزرگ مرکزی -->
        <Style x:Key="RecordButtonLarge" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="130" Height="130">
                            <Ellipse Width="128" Height="128" Stroke="#192544" StrokeThickness="1.5" Fill="#0D1426" Opacity="0.7"/>
                            <Ellipse Width="112" Height="112" Stroke="#233460" StrokeThickness="1.5" Fill="#111A30" Opacity="0.9"/>
                            <Border x:Name="back" Width="92" Height="92" CornerRadius="46" Background="{StaticResource BrandGradient}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6366F1" BlurRadius="30" ShadowDepth="0" Opacity="0.45"/>
                                </Border.Effect>
                                <Path Data="M12,2 C9.79,2 8,3.79 8,6 L8,13 C8,15.21 9.79,17 12,17 C14.21,17 16,15.21 16,13 L16,6 C16,3.79 14.21,2 12,2 Z M19,11 C19,14.53 16.39,17.44 13,17.93 L13,21 L11,21 L11,17.93 C7.61,17.44 5,14.53 5,11 L7,11 C7,13.76 9.24,16 12,16 C14.76,16 17,13.76 17,11 L19,11 Z"
                                      Fill="White" Stretch="Uniform" Width="28" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="back" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- استایل دکمه‌های آیکونی کوچک در کارت‌ها -->
        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2942"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- قاب اصلی برنامه -->
    <Border CornerRadius="14" Background="#0A0E17" BorderBrush="#1C2539" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <!-- هدر بالای برنامه -->
                <RowDefinition Height="*"/>
                <!-- بدنه اصلی -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="185" MaxWidth="250"/>
                <!-- سایدبار -->
                <ColumnDefinition Width="1.65*" MinWidth="460"/>
                <!-- ستون وسط -->
                <ColumnDefinition Width="1.15*" MinWidth="340" MaxWidth="430"/>
                <!-- ستون راست -->
            </Grid.ColumnDefinitions>

            <!-- ===================== ۱. هدر بالای صفحه ===================== -->
            <!-- هدر بالای برنامه با قابلیت درگ و جابه‌جایی پنجره -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0B0F1A" CornerRadius="14,14,0,0" BorderBrush="#151D2E" BorderThickness="0,0,0,1" MouseLeftButtonDown="HeaderGrid_MouseDown">
                <Grid Margin="20,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- لوگو و عنوان Voxora -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Canvas Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Rectangle Width="3.5" Height="10" RadiusX="1.7" RadiusY="1.7" Fill="#3B82F6" Canvas.Left="2" Canvas.Top="9"/>
                            <Rectangle Width="3.5" Height="20" RadiusX="1.7" RadiusY="1.7" Fill="#4F86F7" Canvas.Left="8" Canvas.Top="4"/>
                            <Rectangle Width="3.5" Height="26" RadiusX="1.7" RadiusY="1.7" Fill="#60A5FA" Canvas.Left="14" Canvas.Top="1"/>
                            <Rectangle Width="3.5" Height="16" RadiusX="1.7" RadiusY="1.7" Fill="#4F86F7" Canvas.Left="20" Canvas.Top="6"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="#3B82F6" Canvas.Left="26" Canvas.Top="12.5"/>
                        </Canvas>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Voxora" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Your Voice, Your Words" FontSize="11" Foreground="#4B7BF5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- دکمه‌های کنترل پنجره و آیکون تنظیمات بالا سمت راست -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,4">
                            <Button Style="{StaticResource WindowControlButton}" Command="{Binding WindowMinimize}">
                                <Rectangle Width="10" Height="1.5" Fill="#7E8BA3"/>
                            </Button>
                            <Button Style="{StaticResource WindowControlButton}" Margin="4,0" Command="{Binding WindowState}">
                                <Rectangle Width="9" Height="9" Stroke="#7E8BA3" StrokeThickness="1.3" RadiusX="1" RadiusY="1"/>
                            </Button>
                            <Button Style="{StaticResource WindowControlButton}" Command="{Binding WindowClose}">
                                <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#7E8BA3" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource SmallIconButton}" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <Path Data="M19.14,12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24,0-.43.17-.47.41l-.36,2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47,0-.59.22L2.74,8.87c-.12.21-.08.47.12.61l2.03,1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03,1.58c-.18.14-.23.41-.12.61l1.92,3.32c.12.22.37.29.59.22l2.39-.96c.5.38,1.03.7,1.62.94l.36,2.54c.05.24.24.41.48.41h3.84c.24,0,.44-.17.47-.41l.36-2.54c.59-.24,1.13-.56,1.62-.94l2.39.96c.22.08.47,0,.59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6s3.6,1.62 3.6,3.6s-1.62,3.6-3.6,3.6z"
                                  Fill="#7E8BA3" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== ۲. سایدبار سمت چپ ===================== -->
            <Border Grid.Row="1" Grid.Column="0" Background="#0C101C" BorderBrush="#151D2E" BorderThickness="0,0,1,0" CornerRadius="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="12,16,12,0">
                        <Button Content="Home" Style="{StaticResource SidebarMenuButtonActive}"
                                Tag="M12,3 L2,12 L5,12 L5,20 L10,20 L10,14 L14,14 L14,20 L19,20 L19,12 L22,12 Z"/>

                        <Button Content="Recordings" Style="{StaticResource SidebarMenuButton}"
                                Tag="M3,10 L5,10 L5,14 L3,14 Z M7,6 L9,6 L9,18 L7,18 Z M11,2 L13,2 L13,22 L11,22 Z M15,6 L17,6 L17,18 L15,18 Z M19,10 L21,10 L21,14 L19,14 Z"/>

                        <Button Content="Settings" Style="{StaticResource SidebarMenuButton}"
                                Tag="M19.14,12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24,0-.43.17-.47.41l-.36,2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47,0-.59.22L2.74,8.87c-.12.21-.08.47.12.61l2.03,1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03,1.58c-.18.14-.23.41-.12.61l1.92,3.32c.12.22.37.29.59.22l2.39-.96c.5.38,1.03.7,1.62.94l.36,2.54c.05.24.24.41.48.41h3.84c.24,0,.44-.17.47-.41l.36-2.54c.59-.24,1.13-.56,1.62-.94l2.39.96c.22.08.47,0,.59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6s3.6,1.62 3.6,3.6s-1.62,3.6-3.6,3.6z"/>

                        <Button Content="About" Style="{StaticResource SidebarMenuButton}"
                                Tag="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M13,17 L11,17 L11,11 L13,11 Z M13,9 L11,9 L11,7 L13,7 Z"/>
                    </StackPanel>

                    <!-- پروفایل پایین سایدبار -->
                    <Border Grid.Row="1" BorderBrush="#151D2E" BorderThickness="0,1,0,0" Padding="14,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="#252F42" BorderBrush="#3A465E" BorderThickness="1">
                                <Path Data="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4-4,1.79-4,4,1.79,4,4,4zm0,2c-2.67,0-8,1.34-8,4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      Fill="#94A3B8" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Voxora" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                <TextBlock Text="Voice • Audio • Text" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===================== ۳. بخش میانی (ضبط و لیست اخیر) ===================== -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="18,14,10,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="245"/>
                    <!-- بخش میکروفون و موج نوری -->
                    <RowDefinition Height="*"/>
                    <!-- لیست ضبط‌های اخیر -->
                </Grid.RowDefinitions>

                <!-- کارت بالایی: Start Recording با موج‌های پس‌زمینه -->
                <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,12">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.65" RadiusY="0.7">
                            <GradientStop Color="#131E3A" Offset="0"/>
                            <GradientStop Color="#0A0E17" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- امواج منحنی پس‌زمینه مشابه عکس -->
                        <Path Data="M0,130 C110,60 200,170 310,110 C420,50 510,150 640,95 L640,250 L0,250 Z"
                              Fill="{StaticResource WaveFillGradient}" Stroke="#1E3264" StrokeThickness="1.2" Stretch="Fill" Opacity="0.65" VerticalAlignment="Bottom" Height="150"/>
                        <Path Data="M0,155 C130,195 240,95 360,145 C480,195 550,120 640,155 L640,250 L0,250 Z"
                              Fill="{StaticResource WaveFillGradient}" Stroke="#192852" StrokeThickness="1" Stretch="Fill" Opacity="0.5" VerticalAlignment="Bottom" Height="125"/>

                        <!-- دکمه میکروفون و متن‌ها -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Style="{StaticResource RecordButtonLarge}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Start Recording" FontWeight="SemiBold" FontSize="15.5" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,12,0,5"/>
                            <TextBlock Text="Press the button to start recording your voice" FontSize="12" Foreground="#7E8BA3" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- کارت پایینی: Recent Recordings -->
                <Border Grid.Row="1" Background="#0D121F" BorderBrush="#151E30" BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- هدر لیست -->
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z M12,8c-2.21,0-4,1.79-4,4s1.79,4,4,4s4-1.79,4-4S14.21,8,12,8z"
                                      Fill="#94A3B8" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Recent Recordings" FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <TextBlock Text="View All →" Foreground="#4B8BF5" FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Right" VerticalAlignment="Center" Cursor="Hand"/>
                        </DockPanel>

                        <!-- ۵ آیتم لیست ضبط‌شده‌ها -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- آیتم ۱ (فعال) -->
                                <Border Background="#162142" BorderBrush="#365299" BorderThickness="1.2" CornerRadius="10" Margin="0,0,0,9" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource CircleActiveButton}" Grid.Column="0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="یادداشت جلسه" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="02:34" FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="•" FontSize="11" Foreground="#64748B" Margin="6,0"/>
                                                <TextBlock Text="2025-10-15 10:24" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Path Grid.Column="2" Data="M0,12 L2,9 L4,15 L6,6 L8,18 L10,3 L12,21 L14,7 L16,17 L18,4 L20,20 L22,8 L24,16 L26,2 L28,22 L30,7 L32,17 L34,5 L36,19 L38,8 L40,16 L42,4 L44,20 L46,9 L48,15 L50,11 L52,13 L54,12"
                                              Stroke="#4F86F7" StrokeThickness="1.6" Height="24" Stretch="Fill" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SmallIconButton}" Margin="0,0,4,0">
                                                <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,.89,2,1.99,2H18c1.1,0,2-.9,2-2V8L14,2zm2,16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5,9H13z" Fill="#CBD5E1" Stretch="Uniform" Width="15" Height="15"/>
